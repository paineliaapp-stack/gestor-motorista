<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Painel.IA — Admin</title>
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.0/chart.umd.min.js"></script>
<style>
:root{--bg:#07090d;--card:#0d1117;--line:rgba(255,255,255,.08);--tx:#EEE9E0;--mt:rgba(238,233,224,.45);--am:#F0B429;--gn:#00D897;--rd:#FF4560}
*{margin:0;padding:0;box-sizing:border-box}
body{background:var(--bg);color:var(--tx);font-family:system-ui,-apple-system,sans-serif;padding:24px;max-width:1100px;margin:0 auto}
h1{font-size:22px;margin-bottom:24px;display:flex;align-items:center;gap:10px}
h1 .p{width:34px;height:34px;border-radius:50%;background:var(--am);color:#000;display:inline-flex;align-items:center;justify-content:center;font-weight:900;font-size:19px}
.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:12px;margin-bottom:28px}
.card{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:18px}
.card .l{font-size:10px;text-transform:uppercase;letter-spacing:.6px;color:var(--mt);margin-bottom:6px}
.card .v{font-size:26px;font-weight:800}
.card.mrr{border-color:rgba(240,180,41,.4)}.card.mrr .v{color:var(--am);font-size:32px}
.vagas{margin:8px 0 28px}
.vt{height:8px;background:rgba(255,255,255,.06);border-radius:6px;overflow:hidden}
.vf{height:100%;background:linear-gradient(90deg,var(--am),var(--gn));border-radius:6px;transition:width 1s}
canvas{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:14px;margin-bottom:28px;max-height:240px}
table{width:100%;border-collapse:collapse;background:var(--card);border:1px solid var(--line);border-radius:14px;overflow:hidden}
th,td{padding:11px 14px;text-align:left;font-size:13px;border-bottom:1px solid var(--line)}
th{font-size:10px;text-transform:uppercase;letter-spacing:.5px;color:var(--mt)}
.st{padding:3px 10px;border-radius:20px;font-size:11px;font-weight:700}
.st-trial{background:rgba(78,158,255,.15);color:#4E9EFF}.st-active{background:rgba(0,216,151,.15);color:var(--gn)}
.st-expired{background:rgba(255,69,96,.12);color:var(--rd)}.st-cancelled{background:rgba(255,255,255,.08);color:var(--mt)}
select{background:var(--card);border:1px solid var(--line);color:var(--tx);border-radius:8px;padding:7px 10px;margin-bottom:12px}
</style>
</head>
<body>
<h1><span class="p">P</span>Painel.IA — Admin</h1>
<div class="grid" id="cards"></div>
<div class="vagas"><div style="font-size:12px;color:var(--mt);margin-bottom:6px">Vagas Fundador: <b id="vg-num" style="color:var(--am)">—</b> de 50</div><div class="vt"><div class="vf" id="vg-fill" style="width:0%"></div></div></div>
<canvas id="chart"></canvas>
<select id="filtro" onchange="carregarUsuarios()"><option value="all">Todos</option><option value="trial">Trial</option><option value="active">Ativos</option><option value="expired">Expirados</option><option value="cancelled">Cancelados</option></select>
<table><thead><tr><th>Nome</th><th>Status</th><th>Plano</th><th>Trial expira</th><th>Cadastro</th></tr></thead><tbody id="tbody"></tbody></table>
<script>
let TOKEN = sessionStorage.getItem('admin_token');
if(!TOKEN){ TOKEN = prompt('Token de admin:'); if(TOKEN) sessionStorage.setItem('admin_token', TOKEN); }
const H = {'X-Admin-Token': TOKEN || ''};
const fmt = v => 'R$ ' + (v||0).toLocaleString('pt-BR',{minimumFractionDigits:2});
const fdt = s => s ? new Date(s).toLocaleDateString('pt-BR') : '—';

async function carregar(){
  const r = await fetch('/admin/metricas',{headers:H});
  if(r.status===401){ sessionStorage.removeItem('admin_token'); alert('Token inválido'); location.reload(); return; }
  const d = await r.json();
  document.getElementById('cards').innerHTML = `
    <div class="card mrr"><div class="l">MRR</div><div class="v">${fmt(d.mrr)}</div></div>
    <div class="card"><div class="l">Usuários</div><div class="v">${d.usuarios_total}</div></div>
    <div class="card"><div class="l">Em trial</div><div class="v" style="color:#4E9EFF">${d.em_trial}</div></div>
    <div class="card"><div class="l">Ativos</div><div class="v" style="color:var(--gn)">${d.ativos}</div></div>
    <div class="card"><div class="l">Conversão</div><div class="v">${d.conversao_pct}%</div></div>
    <div class="card"><div class="l">Novos (7d)</div><div class="v">${d.novos_semana}</div></div>`;
  document.getElementById('vg-num').textContent = d.vagas_fundador;
  document.getElementById('vg-fill').style.width = ((50-d.vagas_fundador)/50*100)+'%';
  new Chart(document.getElementById('chart'),{type:'line',data:{
    labels:d.por_dia.map(x=>x.dia.slice(5)),
    datasets:[{label:'Novos usuários',data:d.por_dia.map(x=>x.n),borderColor:'#F0B429',backgroundColor:'rgba(240,180,41,.08)',fill:true,tension:.35,pointRadius:0}]
  },options:{plugins:{legend:{display:false}},scales:{x:{grid:{color:'rgba(255,255,255,.04)'},ticks:{color:'rgba(238,233,224,.4)',maxTicksLimit:10}},y:{grid:{color:'rgba(255,255,255,.04)'},ticks:{color:'rgba(238,233,224,.4)',precision:0}}}}});
  carregarUsuarios();
}
async function carregarUsuarios(){
  const st = document.getElementById('filtro').value;
  const r = await fetch('/admin/usuarios?status='+st+'&limit=50',{headers:H});
  const d = await r.json();
  document.getElementById('tbody').innerHTML = (d.usuarios||[]).map(u=>`
    <tr><td>${u.nome||'—'}</td><td><span class="st st-${u.status}">${u.status}</span></td>
    <td>${u.plano||'—'}</td><td>${fdt(u.trial_fim)}</td><td>${fdt(u.criado_em)}</td></tr>`).join('') || '<tr><td colspan="5" style="color:var(--mt)">Nenhum usuário</td></tr>';
}
carregar();
</script>
</body>
</html>
